<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>WORKER PRO — Industrial Data Center</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f4f7f5;
    color:#123;
}

header{
    background:#063d25;
    color:white;
    padding:22px 15px;
    text-align:center;
}

.logo{
    font-size:32px;
    font-weight:bold;
    color:#b7ff35;
}

.subtitle{
    margin-top:6px;
    font-size:16px;
}

.languages{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:7px;
    margin-top:18px;
}

.languages button{
    border:1px solid #b7ff35;
    background:#0b6b3d;
    color:white;
    padding:8px 12px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

.languages button:hover{
    background:#b7ff35;
    color:#063d25;
}

.container{
    max-width:1100px;
    margin:auto;
    padding:20px;
}

.hero{
    background:white;
    border-radius:16px;
    padding:28px;
    box-shadow:0 4px 14px rgba(0,0,0,.08);
    margin-bottom:20px;
}

.hero h1{
    color:#063d25;
    margin-top:0;
    font-size:32px;
}

.hero p{
    line-height:1.6;
    font-size:17px;
}

.tags{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:18px;
}

.tag{
    background:#e8f5ed;
    color:#063d25;
    padding:8px 12px;
    border-radius:20px;
    font-weight:bold;
}

.stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:15px;
    margin-bottom:20px;
}

.stat{
    background:#063d25;
    color:white;
    border-radius:14px;
    padding:22px;
    text-align:center;
}

.stat strong{
    display:block;
    font-size:29px;
    color:#b7ff35;
    margin-bottom:7px;
}

.section{
    background:white;
    border-radius:16px;
    padding:25px;
    margin-bottom:20px;
    box-shadow:0 4px 14px rgba(0,0,0,.07);
}

.section h2{
    color:#063d25;
    margin-top:0;
}

.flow{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(130px,1fr));
    gap:10px;
    align-items:center;
}

.flow-box{
    background:#0b6b3d;
    color:white;
    padding:16px 10px;
    text-align:center;
    border-radius:12px;
    font-weight:bold;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:15px;
}

.card{
    border:1px solid #d9e5de;
    border-radius:13px;
    padding:18px;
    background:#fafcfb;
}

.card h3{
    color:#0b6b3d;
    margin-top:0;
}

.table-wrap{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}

th,td{
    padding:12px;
    border-bottom:1px solid #dce7e1;
    text-align:left;
}

th{
    background:#063d25;
    color:white;
}

.status{
    display:inline-block;
    padding:5px 9px;
    border-radius:15px;
    background:#dff5e7;
    color:#086336;
    font-weight:bold;
}

.search{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:15px;
}

.search input,
.form input,
.form select{
    flex:1;
    min-width:200px;
    padding:12px;
    border:1px solid #bfd2c7;
    border-radius:8px;
    font-size:15px;
}

button.action{
    background:#0b6b3d;
    color:white;
    border:0;
    border-radius:8px;
    padding:11px 16px;
    cursor:pointer;
    font-weight:bold;
}

button.action:hover{
    background:#063d25;
}

.progress{
    background:#dfe9e3;
    border-radius:20px;
    height:14px;
    overflow:hidden;
    margin-top:8px;
}

.progress span{
    display:block;
    height:100%;
    background:#0b6b3d;
}

.metric{
    margin-bottom:17px;
}

.metric strong{
    color:#063d25;
}

.notice{
    background:#fff8df;
    border-left:5px solid #e3ad00;
    padding:16px;
    border-radius:8px;
    line-height:1.5;
}

.security{
    background:#eef8f2;
    border-left:5px solid #0b6b3d;
    padding:15px;
    border-radius:8px;
}

.form{
    display:grid;
    grid-template-columns:1fr 1fr auto;
    gap:10px;
}

.related{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
}

.related a{
    text-decoration:none;
    background:#e8f5ed;
    color:#063d25;
    padding:9px 12px;
    border-radius:8px;
    font-weight:bold;
}

footer{
    background:#063d25;
    color:white;
    text-align:center;
    padding:25px 15px;
    margin-top:25px;
}

@media(max-width:700px){
    .hero h1{
        font-size:25px;
    }

    .form{
        grid-template-columns:1fr;
    }

    .flow{
        grid-template-columns:1fr;
    }

    .flow-box{
        padding:14px;
    }
}
</style>
</head>

