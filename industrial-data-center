<script>

function filterCenters(){

    const input =
        document.getElementById("searchInput")
        .value
        .toLowerCase();

    const rows =
        document.querySelectorAll("#centerTable tr");

    rows.forEach(function(row){

        const text =
            row.innerText.toLowerCase();

        row.style.display =
            text.includes(input) ? "" : "none";

    });

}

function serverDemo(){

    alert(
        "🖥️ Server Infrastructure\n\n" +
        "Servers: 186\n" +
        "CPU Utilization: 72%\n" +
        "Memory Utilization: 68%\n" +
        "Status: ONLINE"
    );

}

function storageDemo(){

    alert(
        "💾 Data Storage\n\n" +
        "Total Capacity: 4.8 PB\n" +
        "Used: 3.1 PB\n" +
        "Available: 1.7 PB\n" +
        "Storage Status: HEALTHY"
    );

}

function backupDemo(){

    alert(
        "🔄 Backup System\n\n" +
        "Last Backup: Successful\n" +
        "Backup Reliability: 99.5%\n" +
        "Recovery System: READY"
    );

}

function securityDemo(){

    alert(
        "🔐 Security Check\n\n" +
        "Network: SECURE\n" +
        "Access Control: ACTIVE\n" +
        "Encryption: ACTIVE\n" +
        "Backup: PROTECTED"
    );

}

function addCenter(){

    const name =
        document.getElementById("centerName").value.trim();

    const type =
        document.getElementById("centerType").value;

    const result =
        document.getElementById("addResult");

    if(!name){

        result.innerHTML =
            "<p style='color:#b00020;font-weight:bold;'>Введите название дата-центра.</p>";

        return;

    }

    result.innerHTML =
        "<div class='security' style='margin-top:15px;'>" +
        "✅ Дата-центр <strong>" +
        name +
        "</strong> (" +
        type +
        ") добавлен в демонстрационный список." +
        "</div>";

    document.getElementById("centerName").value = "";

}

</script>

