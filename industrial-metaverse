<script>

function filterMeta(){

    const search =
        document.getElementById("search")
        .value
        .toLowerCase();

    const location =
        document.getElementById("locationFilter")
        .value;

    const type =
        document.getElementById("typeFilter")
        .value;

    const environments =
        document.querySelectorAll(".meta-card");

    environments.forEach(function(environment){

        const name =
            environment.dataset.name.toLowerCase();

        const environmentLocation =
            environment.dataset.location;

        const environmentType =
            environment.dataset.type;

        const matchName =
            name.includes(search);

        const matchLocation =
            !location ||
            environmentLocation === location;

        const matchType =
            !type ||
            environmentType === type;

        environment.style.display =
            matchName &&
            matchLocation &&
            matchType
            ? "block"
            : "none";

    });
}

function factoryDemo(){

    document.getElementById("factoryResult").innerHTML =
        "🏭 Virtual Factory открыта. Цифровая производственная среда готова.";

}

function collaborationDemo(){

    document.getElementById("collaborationResult").innerHTML =
        "🌍 Global Collaboration запущен. Виртуальное пространство для специалистов готово.";

}

function aiDemo(){

    document.getElementById("aiResult").innerHTML =
        "🤖 AI + Metaverse анализ завершён. Цифровые данные обработаны.";

}

function addEnvironment(){

    const name =
        document.getElementById("newEnvironment")
        .value
        .trim();

    const type =
        document.getElementById("newType")
        .value;

    if(!name){

        document.getElementById("addResult").innerHTML =
            "⚠️ Введите название виртуальной среды.";

        return;
    }

    document.getElementById("addResult").innerHTML =
        "✅ Virtual Environment добавлена: " +
        name +
        " — " +
        type;

    document.getElementById("newEnvironment").value = "";

}

</script>

